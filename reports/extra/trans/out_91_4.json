  "s1770_9": ["(T-Trouble!)", "Д-Дурно!"],
  "s1770_10": ["Mm… Saito…?", "Мм… Сайто…?"],
  "s1770_11": ["…Snore, snore, snore.", "…Храп, храп, храп."],
  "s1770_12": ["…Was it a dream? I wonder.", "…Может, это сон?"],
  "s1770_13": ["…Mumble mumble mumble.", "…Мня-мня-мня."],
  "s1770_14": ["…", "…"],
  "s1770_15": ["Really, you're such an idiot.", "Правда, какой же ты глупышка."],

  "s1771_2": ["(S-Stop! I said stop!)", "П-Прекрати! Я же говорю!"],
  "s1771_3": ["(I-It's like my body won't listen to me…)", "Т-Точно тело меня не слушается…"],
