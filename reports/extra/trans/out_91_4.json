  "c1760_1763": ["M-More!?", "Е-Ещё!?"],

  "s1761_2": ["S-Stop it!", "П-Прекрати!"],
  "s1761_4": ["W-What! You don't like this?", "Ч-Что! Тебе это не нравится?"],
