    6529
   ],
   "ja": [
    "いいけど、あまり飲みすぎておなかこわすなよ？",
    "dialogs.rpy",
    6523
   ]
  },
  {
   "line": 19,
   "who": "l",
   "voice": "ch2.7_l_003",
   "en": "No! Once I've made up my mind, the only way is forward!",
