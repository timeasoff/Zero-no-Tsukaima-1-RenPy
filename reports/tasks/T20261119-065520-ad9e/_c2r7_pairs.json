{
 "records": [
  {
   "line": 12,
   "who": "l",
   "voice": "ch2.7_l_001",
   "en": "Anyway! I'm going to drink. Just watch me!",
   "ru": [
    "В любом случае! Я пью. Только смотрите!",
    "dialogs.rpy",
    6523
   ],
   "ja": [
    "と・に・か・く。わたしは飲むの。飲んでみせるの！",
    "dialogs.rpy",
    6517
   ]
  },
  {
   "line": 14,
   "who": "l",
   "voice": "ch2.7_l_002",
   "en": "You'll see! I'll grow so big that Kirche and Siesta won't even reach my feet!",
   "ru": [
    "Увидите! Я вырасту так, что Кирхе и Сиеста не дотянутся и до моих пят!",
    "dialogs.rpy",
    6526
   ],
   "ja": [
    "今に見てなさい！キュルケやシエスタなんて足元にも及ばないほどおっきくなってやるんだからーっ！",
    "dialogs.rpy",
    6520
   ]
  },
  {
   "line": 15,
   "who": "th",
   "voice": null,
   "en": "Whew... Louise has it rough too, in her own way. I really do admire that grit of hers.",
   "ru": [
    "Фух… И у Луизы трудности. За такое упрямство — уважаю, честно.",
    "thoughs.rpy",
    504
