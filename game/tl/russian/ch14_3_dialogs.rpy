    old "No! Don't shake her…!{#ch14_m_006}"
    new "Нельзя! Не тряси её…!"

    old "…{#ch14_k_072}"
    new "…"

    old "…Kirche?{#ch14_s_092}"
    new "…Кирке?"

    old "…?{#ch14_k_073}"
    new "…?"

    old "…?{#ch14_t_002}"
    new "…?"

    old "…?{#ch14_k_074}"
    new "…?"

