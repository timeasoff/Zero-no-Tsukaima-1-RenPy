# Directories that Ren'Py changes files in.
/game/saves
/game/cache

# Compiled script files. These are important for saving, and so should
# be preserved by developer and build systems after the game has been released.
/game/**/*.rpyc
/game/**/*.rpymc

# Files Ren'Py can generate.
/game/**/*.bak
/game/**/*.new
/game/**/*.old

# Error, log, and output files.
/errors.txt
/files.txt
/image_cache.txt
/log.txt
/save_dump.txt
/traceback.txt

# Launcher-generated files.
/dialogue.tab
/dialogue.txt
/strings.json

# Python bytecode (tools/)
__pycache__/
*.pyc

#ignore big files
/game/gui/
/game/images/
/game/video/
/game/audio/
/game/saves/

/game/**/*.wav
/game/**/*.ogg
/game/**/*.png
/game/**/*.webp
/game/**/*.mp4
/game/**/*.webm
/game/**/*.zip
/game/**/*.rar
/game/**/*.psd
/game/**/*.xcf
/game/**/*.clip

/game/combined_rpy.md
/agent_prompt.md
/wav_source
/unused_resourses

# ps2_source/images: в git только каркас папок (.gitkeep), исходные картинки — нет
/ps2_source/images/bg/*
/ps2_source/images/cg/*
/ps2_source/images/chara/*
!/ps2_source/images/bg/.gitkeep
!/ps2_source/images/cg/.gitkeep
!/ps2_source/images/chara/.gitkeep
